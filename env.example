# Minimal configuration for sparse Airbyte -> warehouse -> dbt smoke tests.
#
# Copy this file to .env and keep real credentials outside the repository:
#
#   cp env.example .env
#   chmod 600 .env
#   set -a && . ./.env && set +a
#
# The runtime does not read Snowflake, Databricks, or Redshift secrets directly
# from environment variables. It accepts private JSON credential files through
# CLI arguments. This avoids keeping a second copy of every secret in .env.


# ---------------------------------------------------------------------------
# Airbyte Self-Managed
# ---------------------------------------------------------------------------

# Required only when this harness installs Airbyte. Use exact versions from a
# certified runtime matrix; "latest" is refused. No certified defaults exist
# yet, so these are intentionally blank.
ABCTL_VERSION=
AIRBYTE_CHART_VERSION=

# URL used by host-side bootstrap/job polling and URL visible to the container
# running Terraform. Change AIRBYTE_RUNNER_URL when this Docker topology does
# not provide host.docker.internal.
AIRBYTE_HARNESS_URL=http://localhost:8000/api/public/v1/
AIRBYTE_RUNNER_URL=http://host.docker.internal:8000/api/public/v1/


# ---------------------------------------------------------------------------
# Private runtime files
# ---------------------------------------------------------------------------

# Absolute directory outside this repository. The commands create generated
# files here and read the administrator input files documented below.
ELT_TASKGEN_RUNTIME_SECRET_DIR=

# Generated by the runtime; do not create or edit manually:
#
#   airbyte-base.json       runtime install-airbyte
#   airbyte-task.json       runtime bootstrap-task
#   snowflake-attempt.json  runtime provision-snowflake
#   databricks-attempt.json runtime provision-databricks
#   redshift-attempt.json   runtime provision-redshift


# ---------------------------------------------------------------------------
# Immutable runner images
# ---------------------------------------------------------------------------

# Each value must be repository@sha256:digest. Fill the Terraform image and
# only the dbt image for the destination currently being tested.
TERRAFORM_RUNNER_IMAGE=
DBT_SNOWFLAKE_RUNNER_IMAGE=
DBT_DATABRICKS_RUNNER_IMAGE=
DBT_REDSHIFT_RUNNER_IMAGE=


# ---------------------------------------------------------------------------
# Databricks provisioning
# ---------------------------------------------------------------------------

# Required only for Databricks. This must identify the attempt-dedicated OAuth
# service principal whose client_id/secret are in databricks-solver.json.
DATABRICKS_SOLVER_PRINCIPAL=


# ---------------------------------------------------------------------------
# Administrator credential files to create outside the repository
# ---------------------------------------------------------------------------

# ${ELT_TASKGEN_RUNTIME_SECRET_DIR}/snowflake-admin.json
# {
#   "account": "",
#   "user": "",
#   "password": ""
# }
# The principal must be able to USE ROLE SYSADMIN and SECURITYADMIN.

# ${ELT_TASKGEN_RUNTIME_SECRET_DIR}/databricks-admin.json
# {
#   "hostname": "",
#   "http_path": "",
#   "client_id": "",
#   "secret": ""
# }

# ${ELT_TASKGEN_RUNTIME_SECRET_DIR}/databricks-solver.json
# {
#   "hostname": "",
#   "http_path": "",
#   "client_id": "",
#   "secret": ""
# }
# The solver credential must use OAuth; the current task installer rejects PAT.

# ${ELT_TASKGEN_RUNTIME_SECRET_DIR}/redshift-admin.json
# {
#   "host": "",
#   "port": 5439,
#   "database": "",
#   "username": "",
#   "password": "",
#   "s3_bucket_name": "",
#   "s3_bucket_region": "",
#   "access_key_id": "",
#   "secret_access_key": ""
# }
# The runtime derives the task staging prefix. The supplied S3 identity must be
# restricted to that attempt's bucket/prefix.

# Release path, task ID, population, attempt directories, destination
# database/catalog/schema, timeouts, and cost limits are per-run CLI/policy
# arguments rather than global secrets, so they are intentionally absent here.
